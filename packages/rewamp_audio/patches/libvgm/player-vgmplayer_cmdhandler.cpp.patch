 void VGMPlayer::Cmd_Ofs16_Data8(void)
 {
 	UINT8 chipType = _CMD_INFO[fData[0x00]].chipType;
@@ -1113,7 +1158,9 @@ void VGMPlayer::Cmd_Ofs8_Data16(void)
