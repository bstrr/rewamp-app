@@ -1313,9 +1317,47 @@ static void ymf271_update(void *info, UINT32 samples, DEV_SMPL** outputs)
 	UINT32 i;
 	int n, g;
 
+	//TODO:  MODIZER changes start / YOYOFR
+	// One oscilloscope voice per GROUP (the 12 channels libvgm mutes): the
+	// sum of the group's carriers, both pans. Written straight into
+	// m_voice_buff like c352.c: the accumul_temp scheme of the previous core
+	// relied on Modizer's flush, which rewamp does not have.
+	int m_voice_ofs=-1;
+	const int m_total_channels=OPX_GROUPS;
+	for (int ii=0;ii<=SOUND_MAXVOICES_BUFFER_FX-m_total_channels;ii++) {
+		if (m_voice_ChipID[ii]==m_voice_current_system) {
+			m_voice_ofs=ii+(m_voice_current_systemSub?m_voice_current_systemPairedOfs:0);
+			break;
+		}
+	}
+	m_voice_current_total=m_total_channels;
+	const int64_t smplIncr=(int64_t)44100*(1<<MODIZER_OSCILLO_OFFSET_FIXEDPOINT)/(chip->rate?chip->rate:44100);
+	if (m_voice_ofs>=0) {
+		// Note of a group = its first sounding carrier. FM: phase increment
+		// (2^32 = one cycle per sample); PCM: 1x step = LA4 (sample convention).
+		for (g=0;g<OPX_GROUPS;g++) {
+			double hz=0;
+			for (int b=0;b<4;b++) {
+				const OPX_SLOT *s=&chip->slots[g+12*b];
+				if (s->eg_state==EG_OFF || !s->c_carrier) continue;
+				if (s->wave==7) {
+					if (((g+12*b)&3)==0) hz=440.0*(double)opx_pcm_step(s,0)/65536.0;
+				} else {
+					hz=(double)opx_phase_inc(s,0)*(double)chip->rate/4294967296.0;
+				}
+				if (hz>0) break;
+			}
+			vgm_last_note[m_voice_ofs+g]=hz;
+			vgm_last_instr[m_voice_ofs+g]=m_voice_ofs+g;
+			vgm_last_vol[m_voice_ofs+g]=(hz>0 && !chip->groups[g].muted)?1:0;
+		}
+	}
+	//TODO:  MODIZER changes end / YOYOFR
+
 	for (i = 0; i < samples; i++)
 	{
 		INT32 acc[2] = { 0, 0 };
+		INT32 vsum[OPX_GROUPS] = { 0 };	//YOYOFR
 		int eg_clock;
 
 		for (g = 0; g < OPX_GROUPS; g++)
@@ -1435,7 +1477,24 @@ static void ymf271_update(void *info, UINT32 samples, DEV_SMPL** outputs)
 #endif
 			acc[0] += opx_pan(out, s->ch_level[0]);
 			acc[1] += opx_pan(out, s->ch_level[1]);
+			vsum[n % 12] += opx_pan(out, s->ch_level[0]) + opx_pan(out, s->ch_level[1]);	//YOYOFR
+		}
+
+		//TODO:  MODIZER changes start / YOYOFR
+		if (m_voice_ofs>=0) {
+			for (g=0;g<OPX_GROUPS;g++) {
+				int64_t ofs_start=m_voice_current_ptr[m_voice_ofs+g];
+				const int64_t ofs_end=ofs_start+smplIncr;
+				// one carrier at full level = 14 bits per pan, two pans summed
+				const int val=vsum[g]>>7;
+				while (ofs_start<ofs_end) {
+					m_voice_buff[m_voice_ofs+g][(ofs_start>>MODIZER_OSCILLO_OFFSET_FIXEDPOINT)&(SOUND_BUFFER_SIZE_SAMPLE*4*2-1)]=LIMIT8(val);
+					ofs_start+=1<<MODIZER_OSCILLO_OFFSET_FIXEDPOINT;
+				}
+				m_voice_current_ptr[m_voice_ofs+g]=ofs_end;
+			}
 		}
+		//TODO:  MODIZER changes end / YOYOFR
 
 		/* one carrier at full level = 14-bit +/-8192 */
 		outputs[0][i] = acc[0];
